# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/noteapp?retryWrites=true&w=majority

# Long, random secret used to sign JWTs
JWT_SECRET=replace_this_with_a_long_random_string

# Set to "production" only when running behind Vercel/a real deployment.
# Leave unset (or "development") for local `npm run dev`.
NODE_ENV=development

# Comma-separated list of allowed frontend origins for CORS, e.g.
# https://your-frontend.vercel.app
# Optional: if omitted, the API reflects any request origin (fine for
# getting started, but tightening this is recommended for production).
CLIENT_URL=
